# Application Settings
APP_NAME=Health Management API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
# Format: postgresql://user:password@host:port/database
# For local development with Docker: postgresql://user:password@host.docker.internal:5432/database
# For local PostgreSQL: postgresql://user:password@localhost:5432/database
DATABASE_URL=postgresql://user:password@localhost:5432/health_management
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=20
DATABASE_POOL_TIMEOUT=30.0

# Security Settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# OAuth Settings (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email Settings (Optional)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_TLS=true
MAIL_SSL=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true
WEBUI_URL=

# API Settings
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]
CUSTOM_DOMAIN=

# CORS Settings
# Format: ["http://localhost:3000", "http://localhost:3001"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:8080", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
CORS_ALLOW_HEADERS=["Accept", "Accept-Language", "Content-Language", "Content-Type", "Authorization", "X-Requested-With", "Origin"]

# Documentation
DOCS_ENABLED=true

# Q&A Service Settings
QA_ENABLED=true
QA_MODEL_PATH=./models/vietnamese-sbert
QA_DATA_PATH=data.xlsx
QA_VOCAB_PATH=tuvung.txt

# GCS Storage Settings (Optional)
GCP_PROJECT_ID=
GCP_MODEL_BUCKET=
GCP_MODEL_BLOB_PATH=models/vietnamese-sbert/
GCP_DATA_BLOB_PATH=data/
MODEL_AUTO_DOWNLOAD=true
MODEL_DOWNLOAD_TIMEOUT=600

# Q&A Behavior Settings
QA_THRESHOLD=0.55
QA_TOP_K=7
QA_MAX_PER_FIELD=5

# OpenAI AI Settings (Optional)
openai_api_key=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_TEMPERATURE=0.5
OPENAI_MAX_TOKENS=400

# Redis Cache Settings (Optional)
ENABLE_REDIS_CACHE=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=true
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECTION_TIMEOUT=5

# Cache TTL Settings (seconds)
CACHE_TTL_QA_ANSWER=1800
CACHE_TTL_QA_SUMMARY=1800
CACHE_TTL_CONVERSATION_LIST=300
CACHE_TTL_CONVERSATION_DETAIL=600
CACHE_TTL_USER_PROFILE=600
CACHE_TTL_MESSAGE_LIST=180

# Rate Limiting
QA_RATE_LIMIT_REQUESTS=10
QA_RATE_LIMIT_WINDOW=60

# Port (for Docker)
PORT=8080
