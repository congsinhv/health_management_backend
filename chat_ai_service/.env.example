# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here
PORT=8080
HOST=0.0.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Q&A Service Configuration
QA_ENABLED=true
QA_MODEL_PATH=./models/qa
QA_DATA_PATH=./data/qa/data.xlsx
QA_VOCAB_PATH=./data/qa/tuvung.txt
QA_THRESHOLD=0.55
QA_TOP_K=7
QA_MAX_PER_FIELD=5

# Model Configuration
MODEL_AUTO_DOWNLOAD=true
MODEL_DOWNLOAD_TIMEOUT=300

# Google Cloud Platform (optional)
GCP_PROJECT_ID=your-gcp-project
GCP_MODEL_BUCKET=your-model-bucket
GCP_MODEL_BLOB_PATH=models/qa/
GCP_DATA_BLOB_PATH=data/qa/

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=150

# OpenAI Service-to-Service (optional)
OPENAI_SERVICE_URL=https://your-openai-service.run.app

# ONNX Runtime Configuration
USE_ONNX=false

# Redis Caching (optional)
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0

# Monitoring and Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Rate Limiting
ENABLE_RATE_LIMITING=true
MAX_CONCURRENT_REQUESTS=10
MAX_REQUESTS_PER_MINUTE=30

# Service-to-Service Communication
MAIN_SERVICE_URL=https://your-main-service.run.app
SERVICE_TIMEOUT=30

# Deployment Environment
DEPLOYMENT_ENV=production
INSTANCE_ID=chat-ai-001