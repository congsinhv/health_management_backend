                  <span class="info-value"
                    >{% if user_input.gender == 'male' %}Nam{% else %}Nữ{% endif
                    %}</span
                  >
                </div>
                <div class="info-row">
                  <span class="info-label">Chiều cao (m)</span>
                  <span class="info-value">{{ user_input.height }} m</span>
                </div>
                <div class="info-row">
                  <span class="info-label">Cân nặng (kg)</span>
                  <span class="info-value">{{ user_input.weight }} kg</span>
                </div>
              </div>
            </div>

            <div class="sidebar-section">
              <h4>Thói quen ăn uống</h4>
              <div class="info-container">
                <div class="info-row">
                  <span class="info-label">Thường xuyên ăn nhiều calo</span>
                  <span class="info-value"
                    >{{ user_input.highCalorieFood }}</span
                  >
                </div>
                <div class="info-row">
                  <span class="info-label">Có thường xuyên ăn rau không?</span>
                  <span class="info-value"
                    >{{ user_input.vegetableFrequency }}</span
                  >
                </div>
                <div class="info-row">
                  <span class="info-label">Uống bao nhiêu nước mỗi ngày?</span>
                  <span class="info-value">{{ user_input.waterIntake }}</span>
                </div>
                <div class="info-row">
                  <span class="info-label">Số lượng bữa ăn chính mỗi ngày</span>
                  <span class="info-value"
                    >{{ user_input.mainMeals }} bữa/ngày</span
                  >
                </div>
                <div class="info-row">
                  <span class="info-label"
                    >Có ăn vặt ăn giữa các bữa ăn chính không?</span
                  >
                  <span class="info-value"
                    >{{ user_input.snackFrequency }}</span
                  >
                </div>
              </div>
            </div>
            <div class="sidebar-section">
              <h4>Thói quen vận động</h4>
              <div class="info-container">
                <div class="info-row">
